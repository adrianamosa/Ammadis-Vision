# NVR TVT del sitio. Placeholders: no son credenciales de Gaucho Grill.
FRIGATE_RTSP_USER=nvr
FRIGATE_RTSP_PASSWORD=change-me
FRIGATE_NVR_HOST=192.168.50.10

# A dónde el plano de control publica eventos. Por defecto, el stub local.
AMMADIS_WEBHOOK_URL=http://cloud-stub:8080/webhooks/ammadis

# POST /debug/inject sin cámaras. Ponlo en false en un sitio real.
AMMADIS_ALLOW_INJECT=true
